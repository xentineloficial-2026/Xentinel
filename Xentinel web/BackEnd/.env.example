# Copie a .env sólo en instalaciones nuevas. En instalaciones existentes, conserve los secretos actuales.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://USUARIO:CLAVE@127.0.0.1:5432/xentinel
# Conexiones máximas del pool. Con el pooler de Supabase (modo sesión) use un valor menor
# que su "pool size" (p. ej. 8 en el plan gratuito).
DB_POOL_MAX=15
JWT_SECRET=
MAIL_ENCRYPTION_KEY=
JWT_TTL_SECONDS=900
ZONA_HORARIA=America/Bogota
RESET_TTL_MINUTES=20
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RESET_PASSWORD_URL=http://localhost:5173/restablecer-contrasena
TRUST_PROXY_HOPS=0
# SMTP es opcional: sin él la recuperación de contraseña responde 503. El plan gratuito de
# Render bloquea los puertos 25, 465 y 587; use un proveedor que acepte el puerto 2525.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Xentinel <no-reply@example.com>"
# Carnet QR firmado (opcional). Sin valor se deriva de JWT_SECRET. Genérelo con
# python -c "import secrets; print(secrets.token_hex(32))" para rotar los QR sin cerrar sesiones.
QR_SECRET=
# true exige el carnet firmado de la app para el método QR (rechaza QR heredados).
QR_REQUIRE_SIGNED=false
# Horas máximas que una sesión puede renovarse sin volver a ingresar la contraseña.
SESSION_MAX_HOURS=12
# Límites. El general se aplica por persona autenticada (o por IP sin sesión); el de
# inicio de sesión, por IP y por cuenta. Si toda la sede sale por una sola IP pública
# (NAT), eleve RATE_LIMIT_AUTH_PER_15MIN (p. ej. 300): el límite por cuenta sigue
# frenando la fuerza bruta.
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
