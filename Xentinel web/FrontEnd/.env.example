# URL pública de la API (sin /api/v1). En Render se define como variable del Static Site.
# Vacía en desarrollo: Vite reenvía /api/v1 al Backend local.
VITE_API_URL=
# Firebase (configuración web pública) para las alertas sísmicas push en el navegador.
# Sin estas variables la web funciona igual, sin notificaciones push.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
