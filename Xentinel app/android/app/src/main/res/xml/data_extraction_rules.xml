<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sin copia en la nube ni transferencia entre dispositivos. La cola de
     accesos sin conexión y la credencial del carnet pertenecen a este teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
